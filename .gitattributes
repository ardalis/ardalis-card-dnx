# Normalize line endings: store and check out text files with LF on every platform,
# regardless of each user's core.autocrlf setting.
* text=auto eol=lf

# Windows-only scripts need CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.nupkg binary
